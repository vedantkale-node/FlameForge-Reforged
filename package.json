{
  "name": "genshin-impact-api-unofficial",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run watch-tailwind\"",
    "start": "node ./dist/server.js",
    "watch-tailwind": "npx tailwindcss -i ./src/styles/input.css -o ./public/css/style.css --watch",
    "build-tailwind": "npx tailwindcss -i ./src/styles/input.css -o ./public/css/style.css",
    "build": "npm run build-tailwind && npx tsc",
    "db:seed": "tsx scripts/seedDataset.ts",
    "db:seed-admin": "tsx scripts/seedAdmin.ts",
    "scrape:all": "tsx scripts/scraperCli.ts --all",
    "scrape:characters": "tsx scripts/scraperCli.ts --characters",
    "scrape:weapons": "tsx scripts/scraperCli.ts --weapons",
    "scrape:artifacts": "tsx scripts/scraperCli.ts --artifacts",
    "scrape:sample": "tsx scripts/scraperCli.ts --sample",
    "mirror:cloudinary": "node scripts/mirrorImagesToCloudinary.js"
  },
  "keywords": [
    "Genshin Impact",
    "API",
    "Gacha",
    "Game"
  ],
  "author": "vedant kale",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedantkale-node/FlameForge-Reforged.git"
  },
  "dependencies": {
    "@tabler/icons-webfont": "^3.46.0",
    "@types/dotenv-safe": "^8.1.3",
    "@types/express": "^4.17.18",
    "@types/express-session": "^1.17.8",
    "@types/request-ip": "^0.0.41",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "browser-sync": "^2.29.3",
    "cheerio": "^1.2.0",
    "cloudinary": "^1.41.0",
    "concurrently": "^8.2.2",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "mongodb": "^6.3.0",
    "mongoose": "^7.5.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.5",
    "puppeteer": "^25.8.0",
    "redis": "^4.6.12",
    "request-ip": "^3.3.0",
    "typescript": "^5.3.3",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/connect-flash": "^0.0.39",
    "@types/multer": "^1.4.9",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.11",
    "autoprefixer": "^10.4.16",
    "express-handlebars": "^7.1.2",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12"
  }
}

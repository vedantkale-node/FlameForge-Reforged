<!-- VIEW INFO / ENTITY DETAILS MODAL (Clean Matte Dark) -->
<!-- ==================================================== -->
<div class="modal hidden fixed inset-0 z-50 flex justify-center items-center p-3 sm:p-6 overflow-y-auto" id="modal-view-info">
  <div class="modal-card bg-[#161b22] text-white w-full max-w-4xl max-h-[90vh] rounded-2xl border border-[#30363d] shadow-2xl flex flex-col overflow-hidden">
    
    <!-- Modal Header Banner -->
    <div class="p-5 sm:p-6 border-b border-[#30363d] bg-[#0d1117] flex items-start justify-between">
      <div class="flex items-center space-x-4">
        <div class="relative">
          <img id="modalInfoImg" src="/assets/images/characters.webp" alt="entity" class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover border border-[#30363d] bg-[#0d1117]" />
          <span id="modalInfoVisionBadge" class="absolute -bottom-1 -right-1 px-2 py-0.2 rounded text-[9px] font-black uppercase bg-red-600 text-white">Pyro</span>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 id="modalInfoName" class="text-xl sm:text-2xl font-bold text-white">Diluc</h3>
            <span id="modalInfoRarity" class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-bold text-xs border border-amber-500/30">5★</span>
          </div>
          <p id="modalInfoSubtitle" class="text-xs text-slate-400 mt-0.5">The Darknight Hero &bull; Dawn Winery</p>
          <div id="modalInfoTags" class="flex flex-wrap gap-1.5 mt-2 text-[11px]">
          </div>
        </div>
      </div>
      <button id="btn-close-view-info" class="p-2 rounded-xl bg-[#21262d] hover:bg-red-600 text-slate-300 hover:text-white transition-colors cursor-pointer">
        <i class="ti ti-x text-lg"></i>
      </button>
    </div>

    <!-- Modal Navigation Tabs -->
    <div class="px-6 py-2 border-b border-[#30363d] bg-[#161b22] flex space-x-2 overflow-x-auto text-xs font-semibold">
      <button class="modal-tab-btn px-3 py-1.5 rounded-lg bg-red-600/20 text-red-300 border border-red-500/30 cursor-pointer" data-tab="tab-overview">Overview & Lore</button>
      <button class="modal-tab-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white cursor-pointer" data-tab="tab-talents">Combat Talents</button>
      <button class="modal-tab-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white cursor-pointer" data-tab="tab-constellations">Constellations</button>
      <button class="modal-tab-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white cursor-pointer" data-tab="tab-stories">Stories & Audio</button>
      <button class="modal-tab-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white cursor-pointer" data-tab="tab-rawjson">Raw JSON</button>
    </div>

    <!-- Modal Content Body -->
    <div class="p-6 overflow-y-auto space-y-4 text-sm max-h-[60vh]" id="modalInfoBody">
      
      <!-- Tab 1: Overview -->
      <div id="tab-overview" class="modal-tab-pane space-y-4">
        <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d]">
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Description & Lore</p>
          <p id="modalInfoDesc" class="text-slate-300 text-xs leading-relaxed"></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs" id="modalInfoAttrGrid">
        </div>
      </div>

      <!-- Tab 2: Talents -->
      <div id="tab-talents" class="modal-tab-pane hidden space-y-3">
        <div id="modalInfoTalentsList" class="space-y-3">
          <p class="text-xs text-slate-400">No combat talents available.</p>
        </div>
      </div>

      <!-- Tab 3: Constellations -->
      <div id="tab-constellations" class="modal-tab-pane hidden space-y-3">
        <div id="modalInfoConstellationsList" class="space-y-3">
          <p class="text-xs text-slate-400">No constellations available.</p>
        </div>
      </div>

      <!-- Tab 4: Stories & Audio -->
      <div id="tab-stories" class="modal-tab-pane hidden space-y-4">
        <div id="modalInfoStoriesList" class="space-y-3"></div>
        <div id="modalInfoVoiceList" class="space-y-3 pt-4 border-t border-[#30363d]"></div>
      </div>

      <!-- Tab 5: Raw JSON -->
      <div id="tab-rawjson" class="modal-tab-pane hidden">
        <div class="p-4 rounded-xl bg-[#0d1117] border border-[#30363d] overflow-x-auto max-h-80">
          <pre class="text-xs text-slate-300 font-mono"><code id="modalInfoJsonCode">{}</code></pre>
        </div>
      </div>

    </div>

    <!-- Modal Footer -->
    <div class="p-4 border-t border-[#30363d] bg-[#0d1117] flex justify-between items-center text-xs">
      <span class="text-slate-400">FlameForge Entity Inspector</span>
      <button id="btn-modal-copy-json" class="px-3 py-1.5 rounded-lg bg-[#21262d] text-slate-200 hover:text-white border border-[#30363d] transition-colors font-medium cursor-pointer flex items-center gap-1.5">
        <i class="ti ti-copy text-sm"></i>
        <span>Copy Full JSON</span>
      </button>
    </div>

  </div>
</div>

<!-- Delete Character Modal -->
<div class="delete-modal-mob modal hidden fixed inset-0 z-50 flex justify-center items-center p-4" id="modal-delete-character">
  <div class="modal-card bg-[#161b22] text-white p-6 w-full max-w-md rounded-2xl border border-[#30363d] shadow-2xl">
    <div class="flex items-center text-rose-400 mb-3">
      <i class="ti ti-alert-triangle text-2xl mr-2"></i>
      <p class="text-lg font-bold">Confirm Deletion</p>
    </div>
    <p class="text-slate-300 text-sm mb-6">Are you sure you want to delete this character? This action cannot be undone.</p>
    <div class="flex justify-end space-x-3">
      <button id="btn-delete-character-modal-close" class="btn-delete-character-modal-close px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 text-xs font-semibold transition-colors cursor-pointer">Cancel</button>
      <form method="POST" id="character-delete-form">
        <button type="submit" id="btn-modal-delete" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-colors cursor-pointer">Delete Character</button>
      </form>
    </div>
  </div>
</div>

<!-- Delete Weapon Modal -->
<div class="delete-modal-mob modal hidden fixed inset-0 z-50 flex justify-center items-center p-4" id="modal-delete-weapon">
  <div class="modal-card bg-[#161b22] text-white p-6 w-full max-w-md rounded-2xl border border-[#30363d] shadow-2xl">
    <div class="flex items-center text-rose-400 mb-3">
      <i class="ti ti-alert-triangle text-2xl mr-2"></i>
      <p class="text-lg font-bold">Confirm Deletion</p>
    </div>
    <p class="text-slate-300 text-sm mb-6">Are you sure you want to delete this weapon from the database?</p>
    <div class="flex justify-end space-x-3">
      <button id="btn-delete-weapon-modal-close" class="btn-delete-weapon-modal-close px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 text-xs font-semibold transition-colors cursor-pointer">Cancel</button>
      <form method="POST" id="weapon-delete-form">
        <button type="submit" id="btn-modal-delete-weapon" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-colors cursor-pointer">Delete Weapon</button>
      </form>
    </div>
  </div>
</div>

<!-- Delete Artifact Modal -->
<div class="delete-modal-mob modal hidden fixed inset-0 z-50 flex justify-center items-center p-4" id="modal-delete-artifact">
  <div class="modal-card bg-[#161b22] text-white p-6 w-full max-w-md rounded-2xl border border-[#30363d] shadow-2xl">
    <div class="flex items-center text-rose-400 mb-3">
      <i class="ti ti-alert-triangle text-2xl mr-2"></i>
      <p class="text-lg font-bold">Confirm Deletion</p>
    </div>
    <p class="text-slate-300 text-sm mb-6">Are you sure you want to delete this artifact set?</p>
    <div class="flex justify-end space-x-3">
      <button id="btn-delete-artifact-modal-close" class="btn-delete-artifact-modal-close px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 text-xs font-semibold transition-colors cursor-pointer">Cancel</button>
      <form method="POST" id="artifact-delete-form">
        <button type="submit" id="btn-modal-delete-artifact" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-colors cursor-pointer">Delete Artifact</button>
      </form>
    </div>
  </div>
</div>

<!-- Delete User Modal (Admin Only) -->
<div class="delete-modal-mob modal hidden fixed inset-0 z-50 flex justify-center items-center p-4 bg-black/80 backdrop-blur-xs" id="modal-delete-user">
  <div class="modal-card bg-[#161b22] text-white p-6 w-full max-w-md rounded-2xl border border-rose-500/40 shadow-2xl space-y-4">
    <div class="flex items-center text-rose-400">
      <i class="ti ti-alert-triangle text-2xl mr-2"></i>
      <p class="text-base font-bold">Delete User Account</p>
    </div>
    <p class="text-slate-300 text-xs leading-relaxed">
      Are you sure you want to permanently delete user <span id="deleteUserName" class="font-bold text-white font-mono">@user</span>? All their profile data will be permanently removed.
    </p>
    <div class="flex justify-end space-x-3 pt-2">
      <button id="btn-delete-user-modal-close" type="button" class="btn-delete-user-modal-close px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 text-xs font-semibold transition-colors cursor-pointer">Cancel</button>
      <form method="POST" id="user-delete-form">
        <button type="submit" id="btn-confirm-delete-user" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-colors cursor-pointer">Delete User</button>
      </form>
    </div>
  </div>
</div>

<!-- Edit Basic User Info Modal (Admin Only) -->
<div class="modal hidden fixed inset-0 z-50 flex justify-center items-center p-4 bg-black/80 backdrop-blur-xs" id="modal-edit-user">
  <div class="modal-card bg-[#161b22] text-white p-6 w-full max-w-md rounded-2xl border border-[#30363d] shadow-2xl space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-[#30363d]">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400">
          <i class="ti ti-user-edit text-base"></i>
        </div>
        <div>
          <p class="text-sm font-bold text-white">Edit User Info</p>
          <p class="text-[11px] text-slate-400" id="editUserSubtitle">@username</p>
        </div>
      </div>
      <button id="btn-edit-user-modal-close" type="button" class="btn-edit-user-modal-close p-1 rounded-lg text-slate-400 hover:text-white hover:bg-[#21262d] transition-colors cursor-pointer">
        <i class="ti ti-x text-base"></i>
      </button>
    </div>

    <form method="POST" id="user-edit-form" class="space-y-3.5">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1">First Name</label>
          <input type="text" name="firstName" id="editUserFirstName" required class="w-full bg-[#0d1117] text-white text-xs border border-[#30363d] focus:border-amber-500 rounded-xl px-3 py-2 outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-400 mb-1">Last Name</label>
          <input type="text" name="lastName" id="editUserLastName" required class="w-full bg-[#0d1117] text-white text-xs border border-[#30363d] focus:border-amber-500 rounded-xl px-3 py-2 outline-none transition-colors" />
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-semibold text-slate-400 mb-1">User Role</label>
        <select name="role" id="editUserRole" class="w-full bg-[#0d1117] text-slate-200 text-xs border border-[#30363d] focus:border-amber-500 rounded-xl px-3 py-2 outline-none transition-colors cursor-pointer">
          <option value="user">User (Standard Member)</option>
          <option value="moderator">Moderator</option>
          <option value="admin">Administrator</option>
        </select>
      </div>

      <div class="flex justify-end gap-2.5 pt-3 border-t border-[#30363d]">
        <button id="btn-edit-user-modal-cancel" type="button" class="btn-edit-user-modal-close px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 text-xs font-semibold transition-colors cursor-pointer">Cancel</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white text-xs font-bold transition-all shadow-md shadow-amber-600/20 cursor-pointer">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- Mobile Header Bar -->
<div class="hamburger bg-[#161b22] sm:hidden z-40 p-4 flex justify-between items-center border-b border-[#30363d] sticky top-0">
  <div class="flex justify-center items-center">
    <img src="/assets/images/dawn.webp" width="26" height="26" alt="FlameForge" class="mr-2">
    <p class="text-white font-bold text-sm tracking-wide">FlameForge</p>
  </div>
  <button class="p-2 rounded-lg bg-[#21262d] text-slate-200 cursor-pointer" id="hamburger-btn">
    <i class="ti ti-menu-2 text-lg"></i>
  </button>
</div>

<!-- Main Layout Shell -->
<div class="min-h-screen flex justify-end bg-[#0d1117] text-slate-100 font-sans">
  
  <!-- Sidebar Shell -->
  <div id="sidebar-main" class="sidebar-main-mob sidebar bg-[#161b22] fixed top-0 left-0 h-full w-64 lg:w-72 p-3 border-r border-[#30363d] flex flex-col justify-between z-40 transition-all duration-200">
    {{> dashboard/sidebar}}
  </div>

  <!-- Main Content Workspace -->
  <div class="main-mob main w-full sm:w-[calc(100%-16rem)] lg:w-[calc(100%-18rem)] px-4 sm:px-8 py-6 overflow-y-auto transition-all duration-200" id="content">
    <div class="max-w-6xl mx-auto">
      
      <!-- Top Title -->
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#30363d]">
        <h1 class="text-xl sm:text-2xl font-bold text-white tracking-wide flex items-center" id="heading">
          Overview
        </h1>
      </div>

      <div id="content-data">
        
        <!-- SECTION 0: Overview -->
        <section id="content-0" class="space-y-6">
          <!-- Main Hero Banner Card (Diluc Reforged Theme) -->
          <div class="p-6 sm:p-10 rounded-3xl bg-[#161b22] border border-red-500/40 shadow-2xl relative overflow-hidden" style="background-image: linear-gradient(135deg, rgba(13, 17, 23, 0.75) 0%, rgba(22, 27, 34, 0.5) 50%, rgba(13, 17, 23, 0.88) 100%), url('/assets/images/namecards/diluc.webp'); background-size: cover; background-position: center;">
            <!-- Flame Glow Accent -->
            <div class="absolute -top-20 -right-20 w-80 h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative z-10 max-w-3xl space-y-4">
              <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-red-500/25 text-red-300 border border-red-500/50 backdrop-blur-sm shadow-md">
                <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
                Teyvat High-Performance Data Architecture
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
                FlameForge <span class="bg-gradient-to-r from-red-400 via-amber-400 to-rose-400 bg-clip-text text-transparent">Reforged</span>
              </h2>
              <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-light max-w-2xl">
                Direct integration with official HoYoWiki static endpoints. Access combat talents, Lv1-13 attribute scaling matrices, constellation tiers, weapon curves, and story lore in high-speed JSON.
              </p>
              
              <div class="flex flex-wrap items-center gap-2.5 pt-2">
                {{#if (eq role 'admin')}}
                <button id="btnQuickOpenStudio" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-700 hover:to-orange-700 text-white font-bold text-xs transition-all flex items-center gap-2 cursor-pointer shadow-md shadow-amber-600/30">
                  <i class="ti ti-bolt text-sm"></i>
                  <span>Scraper Studio</span>
                </button>
                {{/if}}
                <a href="/" target="_blank" class="px-4 py-2.5 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-200 hover:text-white border border-[#30363d] font-semibold text-xs transition-colors flex items-center gap-2 cursor-pointer">
                  <i class="ti ti-book text-sm text-amber-400"></i>
                  <span>OpenAPI Docs</span>
                </a>
                <a href="/about" class="px-4 py-2.5 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-200 hover:text-white border border-[#30363d] font-semibold text-xs transition-colors flex items-center gap-2 cursor-pointer">
                  <i class="ti ti-info-circle text-sm text-indigo-400"></i>
                  <span>System Architecture</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Universe Metrics 4-Card Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
            <!-- Characters Stat Card -->
            <div class="p-4 rounded-2xl bg-[#161b22] border border-[#30363d] hover:border-red-500/50 transition-all flex items-center justify-between group shadow-lg">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-red-500/15 border border-red-500/30 flex items-center justify-center text-red-400 shrink-0">
                  <i class="ti ti-users text-xl"></i>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">Characters</p>
                  <p class="text-xl font-black text-white tracking-wide">{{characterCount}}</p>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-500/20 text-red-300 border border-red-500/30">Archive</span>
            </div>

            <!-- Weapons Stat Card -->
            <div class="p-4 rounded-2xl bg-[#161b22] border border-[#30363d] hover:border-amber-500/50 transition-all flex items-center justify-between group shadow-lg">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 shrink-0">
                  <i class="ti ti-swords text-xl"></i>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">Weapons</p>
                  <p class="text-xl font-black text-white tracking-wide">{{weaponCount}}</p>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">Armory</span>
            </div>

            <!-- Artifacts Stat Card -->
            <div class="p-4 rounded-2xl bg-[#161b22] border border-[#30363d] hover:border-indigo-500/50 transition-all flex items-center justify-between group shadow-lg">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0">
                  <i class="ti ti-sparkles text-xl"></i>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">Artifact Sets</p>
                  <p class="text-xl font-black text-white tracking-wide">{{artifactCount}}</p>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">Relics</span>
            </div>

            <!-- Community Stat Card -->
            <div class="p-4 rounded-2xl bg-[#161b22] border border-[#30363d] hover:border-emerald-500/50 transition-all flex items-center justify-between group shadow-lg">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
                  <i class="ti ti-user-check text-xl"></i>
                </div>
                <div>
                  <p class="text-[10px] text-slate-400 uppercase tracking-wider font-bold">Community</p>
                  <p class="text-xl font-black text-white tracking-wide">{{users.length}}</p>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Adventurers</span>
            </div>
          </div>

          <!-- System Telemetry & Quick Architecture Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Engine Telemetry Card -->
            <div class="p-5 sm:p-6 rounded-2xl bg-[#161b22] border border-[#30363d] space-y-4 shadow-xl">
              <div class="flex items-center justify-between pb-3 border-b border-[#30363d]">
                <div class="flex items-center gap-2">
                  <i class="ti ti-activity-heartbeat text-red-400 text-lg"></i>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200">System Telemetry & Health</h3>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> Live & Healthy
                </span>
              </div>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-1">
                  <p class="text-[10px] text-slate-400 uppercase font-mono">Database Cluster</p>
                  <p class="font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span> MongoDB Atlas
                  </p>
                </div>
                <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-1">
                  <p class="text-[10px] text-slate-400 uppercase font-mono">Crawler Engine</p>
                  <p class="font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span> ~15s Concurrency
                  </p>
                </div>
                <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-1">
                  <p class="text-[10px] text-slate-400 uppercase font-mono">REST Endpoints</p>
                  <p class="font-bold text-white flex items-center gap-1.5">

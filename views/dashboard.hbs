                <div>
                  <p class="text-xs font-bold text-white">128 Characters</p>
                  <p class="text-[11px] text-slate-400">Talents, Scaling & Lore</p>
                </div>
                <button id="btnSyncChars" class="mt-3 w-full py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                  <i class="ti ti-download text-sm"></i> <span>Sync Characters (~4s)</span>
                </button>
              </div>

              <div class="p-3.5 rounded-xl bg-[#0d1117] border border-[#30363d] flex flex-col justify-between">
                <div>
                  <p class="text-xs font-bold text-white">245 Weapons</p>
                  <p class="text-[11px] text-slate-400">Stats Table & Passives</p>
                </div>
                <button id="btnSyncWeaps" class="mt-3 w-full py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                  <i class="ti ti-download text-sm"></i> <span>Sync Weapons (~9s)</span>
                </button>
              </div>

              <div class="p-3.5 rounded-xl bg-[#0d1117] border border-[#30363d] flex flex-col justify-between">
                <div>
                  <p class="text-xs font-bold text-white">63 Artifacts</p>
                  <p class="text-[11px] text-slate-400">Full 5-Piece Sets</p>
                </div>
                <button id="btnSyncArts" class="mt-3 w-full py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
                  <i class="ti ti-download text-sm"></i> <span>Sync Artifacts (~2s)</span>
                </button>
              </div>

              <div class="p-3.5 rounded-xl bg-[#0d1117] border border-red-500/30 flex flex-col justify-between">
                <div>
                  <p class="text-xs font-bold text-red-300">Entire Universe</p>
                  <p class="text-[11px] text-slate-400">All 436 Entities</p>
                </div>
                <button id="btnSyncUniverse" class="mt-3 w-full py-2 rounded-lg bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer shadow-md shadow-red-600/30">
                  <i class="ti ti-rocket text-sm"></i> <span>🚀 Sync All (~15s)</span>
                </button>
              </div>
            </div>
          </div>
          {{/if}}

          <!-- Execution Console Stream (Visible to Staff) -->
          <div class="matte-card p-5 rounded-2xl">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-slate-300 font-mono font-bold flex items-center">
                <span class="w-2 h-2 rounded-full bg-emerald-500 mr-2 animate-pulse"></span> Engine Execution Stream
              </span>
              <button id="btnClearConsole" class="text-[11px] text-slate-400 hover:text-white font-mono cursor-pointer px-2.5 py-1 rounded-lg bg-[#21262d] hover:bg-[#30363d] transition-colors">Clear Stream</button>
            </div>
            <div id="scraperConsoleBox" class="p-3.5 rounded-xl bg-[#0b0e14] border border-[#30363d] font-mono text-xs text-slate-300 space-y-1 max-h-48 overflow-y-auto">
              <p class="text-slate-500">> HoYoWiki Scraper Engine v2.0 connected. Ready for commands.</p>
            </div>
          </div>
        </section>
        {{/if}}

        <!-- SECTION 4: Database Admin Control -->
        {{#if (eq role 'admin')}}
        <section id="content-4" class="space-y-5" style="display:none;">
          
          <!-- Search & Multi-Filter Control Panel -->
          <div class="matte-card-diluc p-5 rounded-2xl bg-[#161b22] border border-[#30363d] shadow-xl space-y-4">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 pb-3 border-b border-[#30363d]">
              <div>
                <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                  <i class="ti ti-shield-lock text-red-400 text-base"></i>
                  <span>Database Admin Center</span>
                </h3>
                <p class="text-[11px] text-slate-400 mt-0.5">Manage records, inspect metadata, download archives, and modify entities.</p>
              </div>
              <div class="flex items-center gap-2">
                <a href="/dashboard/characters/download" title="Export Characters JSON" class="px-3 py-1.5 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 hover:text-white border border-[#30363d] text-xs font-semibold flex items-center gap-1.5 transition-colors">
                  <i class="ti ti-download text-red-400"></i> Characters
                </a>
                <a href="/dashboard/weapons/download" title="Export Weapons JSON" class="px-3 py-1.5 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 hover:text-white border border-[#30363d] text-xs font-semibold flex items-center gap-1.5 transition-colors">
                  <i class="ti ti-download text-amber-400"></i> Weapons
                </a>
                <a href="/dashboard/artifacts/download" title="Export Artifacts JSON" class="px-3 py-1.5 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-slate-300 hover:text-white border border-[#30363d] text-xs font-semibold flex items-center gap-1.5 transition-colors">
                  <i class="ti ti-download text-indigo-400"></i> Artifacts
                </a>
              </div>
            </div>

            <!-- Global Search & Selectors Toolbar -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <!-- Search Bar -->
              <div class="sm:col-span-2 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                  <i class="ti ti-search"></i>
                </span>
                <input type="text" id="adminSearchInput" placeholder="Search by name, region, family, element..." class="w-full bg-[#0d1117] text-white text-xs border border-[#30363d] focus:border-red-500 rounded-xl pl-8 pr-3 py-2 outline-none transition-all placeholder-slate-500" />
              </div>

              <!-- Category Filter Selector -->
              <div>
                <select id="adminCategoryFilter" class="w-full bg-[#0d1117] text-slate-200 text-xs border border-[#30363d] focus:border-red-500 rounded-xl px-3 py-2 outline-none transition-all cursor-pointer">
                  <option value="all">📁 All Categories (All Records)</option>
                  <option value="character">🎴 Characters ({{characterCount}})</option>
                  <option value="weapon">⚔️ Weapons ({{weaponCount}})</option>
                  <option value="artifact">🏺 Artifacts ({{artifactCount}})</option>
                </select>
              </div>

              <!-- Rarity Filter Selector -->
              <div>
                <select id="adminRarityFilter" class="w-full bg-[#0d1117] text-slate-200 text-xs border border-[#30363d] focus:border-red-500 rounded-xl px-3 py-2 outline-none transition-all cursor-pointer">
                  <option value="all">⭐ All Rarities</option>
                  <option value="5">5★ Legendary</option>
                  <option value="4">4★ Epic</option>
                  <option value="3">3★ Rare</option>
                  <option value="2">2★ Uncommon</option>
                  <option value="1">1★ Common</option>
                </select>
              </div>
            </div>

            <!-- Second Filter Row: Vision & Weapon Type -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div>
                <select id="adminVisionFilter" class="w-full bg-[#0d1117] text-slate-200 text-xs border border-[#30363d] focus:border-red-500 rounded-xl px-3 py-2 outline-none transition-all cursor-pointer">
                  <option value="all">🔮 All Elements / Visions</option>
                  <option value="Pyro">🔥 Pyro</option>
                  <option value="Hydro">💧 Hydro</option>
                  <option value="Anemo">🌪️ Anemo</option>
                  <option value="Electro">⚡ Electro</option>
                  <option value="Dendro">🌿 Dendro</option>
                  <option value="Cryo">❄️ Cryo</option>
                  <option value="Geo">🪨 Geo</option>
                </select>
              </div>

              <div>
                <select id="adminWeaponFilter" class="w-full bg-[#0d1117] text-slate-200 text-xs border border-[#30363d] focus:border-red-500 rounded-xl px-3 py-2 outline-none transition-all cursor-pointer">
                  <option value="all">⚔️ All Weapon Types</option>
                  <option value="Sword">🗡️ Sword</option>
                  <option value="Claymore">🗡️ Claymore</option>
                  <option value="Polearm">🔱 Polearm</option>
                  <option value="Bow">🏹 Bow</option>
                  <option value="Catalyst">📖 Catalyst</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Characters Management List -->
          <div id="adminCharSection" class="admin-data-section">
            <h3 class="text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider flex items-center justify-between">
              <span>Characters (<span id="adminCharVisibleCount">{{characterCount}}</span>)</span>
            </h3>
            <div class="space-y-1.5 text-xs">
              {{#each characters}}
              <div class="character-list p-2.5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between hover:border-red-500/50 transition-colors" data-name="{{this.name}}" data-vision="{{this.vision}}" data-weapon="{{this.weapon}}" data-rarity="{{this.rarity}}" data-category="character">
                <div class="flex items-center space-x-3">
                  <img src="{{this.images.profile}}" alt="{{this.name}}" class="w-8 h-8 rounded-lg object-cover bg-[#0d1117]" onerror="this.src='/assets/images/characters.webp'" />
                  <div>
                    <p class="character-title font-bold text-white">{{this.name}}</p>
                    <p class="text-[11px] text-slate-400">{{this.rarity}}★ {{this.vision}} {{this.weapon}}</p>
                  </div>
                </div>
                <div class="flex items-center space-x-1.5">
                  <button title="View Info" data-category="character" data-id="{{this._id}}" class="view-info-btn p-1.5 rounded-lg bg-[#21262d] text-slate-300 hover:text-white cursor-pointer">
                    <i class="ti ti-eye text-sm"></i>
                  </button>
                  <a href="/dashboard/character/edit/{{this._id}}" class="p-1.5 rounded-lg bg-[#21262d] text-amber-300 hover:text-amber-200 cursor-pointer">
                    <i class="ti ti-edit text-sm"></i>
                  </a>
                  <button data-characterid="{{this._id}}" class="delete-character-btn p-1.5 rounded-lg bg-[#21262d] text-rose-400 hover:text-rose-300 cursor-pointer">
                    <i class="ti ti-trash text-sm"></i>
                  </button>
                </div>
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Weapons Management List -->
          <div id="adminWeapSection" class="admin-data-section mt-6">
            <h3 class="text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider flex items-center justify-between">
              <span>Weapons (<span id="adminWeapVisibleCount">{{weaponCount}}</span>)</span>
            </h3>
            <div class="space-y-1.5 text-xs">
              {{#each weapons}}
              <div class="weapon-list p-2.5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between hover:border-amber-500/50 transition-colors" data-name="{{this.name}}" data-family="{{this.family}}" data-weapon="{{this.family}}" data-rarity="{{this.rarity}}" data-category="weapon">
                <div class="flex items-center space-x-3">
                  <img src="{{this.images.icon}}" alt="{{this.name}}" class="w-8 h-8 rounded-lg object-cover bg-[#0d1117]" onerror="this.src='/assets/images/weapons.webp'" />
                  <div>
                    <p class="weapon-title font-bold text-white">{{this.name}}</p>
                    <p class="text-[11px] text-slate-400">{{this.rarity}}★ {{this.family}}</p>
                  </div>
                </div>
                <div class="flex items-center space-x-1.5">
                  <button title="View Info" data-category="weapon" data-id="{{this._id}}" class="view-info-btn p-1.5 rounded-lg bg-[#21262d] text-slate-300 hover:text-white cursor-pointer">
                    <i class="ti ti-eye text-sm"></i>
                  </button>
                  <a href="/dashboard/weapon/edit/{{this._id}}" class="p-1.5 rounded-lg bg-[#21262d] text-amber-300 hover:text-amber-200 cursor-pointer">
                    <i class="ti ti-edit text-sm"></i>
                  </a>
                  <button data-weaponid="{{this._id}}" class="delete-weapon-btn p-1.5 rounded-lg bg-[#21262d] text-rose-400 hover:text-rose-300 cursor-pointer">
                    <i class="ti ti-trash text-sm"></i>
                  </button>
                </div>
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Artifacts Management List -->
          <div id="adminArtSection" class="admin-data-section mt-6">
            <h3 class="text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider flex items-center justify-between">
              <span>Artifact Sets (<span id="adminArtVisibleCount">{{artifactCount}}</span>)</span>
            </h3>
            <div class="space-y-1.5 text-xs">
              {{#each artifacts}}
              <div class="artifact-list p-2.5 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-between hover:border-indigo-500/50 transition-colors" data-name="{{this.name}}" data-category="artifact">
                <div class="flex items-center space-x-3">
                  <img src="{{this.fullSet.flower.icon}}" alt="{{this.name}}" class="w-8 h-8 rounded-lg object-cover bg-[#0d1117]" onerror="this.src='/assets/images/artifacts.webp'" />
                  <div>
                    <p class="artifact-title font-bold text-white">{{this.name}}</p>
                    <p class="text-[11px] text-slate-400">5★ Artifact Set</p>
                  </div>
                </div>
                <div class="flex items-center space-x-1.5">
                  <button title="View Info" data-category="artifact" data-id="{{this._id}}" class="view-info-btn p-1.5 rounded-lg bg-[#21262d] text-slate-300 hover:text-white cursor-pointer">
                    <i class="ti ti-eye text-sm"></i>
                  </button>
                  <a href="/dashboard/artifact/edit/{{this._id}}" class="p-1.5 rounded-lg bg-[#21262d] text-indigo-300 hover:text-indigo-200 cursor-pointer">
                    <i class="ti ti-edit text-sm"></i>
                  </a>
                  <button data-artifactid="{{this._id}}" class="delete-artifact-btn p-1.5 rounded-lg bg-[#21262d] text-rose-400 hover:text-rose-300 cursor-pointer">
                    <i class="ti ti-trash text-sm"></i>
                  </button>
                </div>
              </div>
              {{/each}}
            </div>
          </div>

          <!-- Empty Search State -->
          <div id="adminNoResults" class="hidden p-8 rounded-2xl bg-[#161b22] border border-[#30363d] text-center space-y-2">
            <i class="ti ti-database-search text-3xl text-slate-500"></i>
            <p class="text-xs font-bold text-slate-300">No database records match your filter criteria.</p>
            <p class="text-[11px] text-slate-500">Try changing your search query, clearing filters, or switching category.</p>
          </div>

        </section>
        {{/if}}

        <!-- SECTION 5: Users Directory -->
        <section id="content-5" class="space-y-5" style="display:none;">
          <!-- Search & Header Bar -->
          <div class="matte-card-diluc p-4 sm:p-5 rounded-2xl bg-[#161b22] border border-[#30363d] shadow-xl space-y-3">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <div>
                <h3 class="text-sm font-bold text-slate-200 uppercase tracking-wider flex items-center gap-2">
                  <i class="ti ti-users text-amber-400 text-base"></i>
                  <span>User Directory (<span id="userVisibleCount">{{users.length}}</span>)</span>
                </h3>
                <p class="text-[11px] text-slate-400 mt-0.5">Explore community members, adventurers, and database administrators.</p>
              </div>
              <div class="w-full sm:w-72 relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-xs">
                  <i class="ti ti-search"></i>
                </span>
                <input type="text" id="userSearchInput" placeholder="Search members by name, username, role..." class="w-full bg-[#0d1117] text-white text-xs border border-[#30363d] focus:border-amber-500 rounded-xl pl-8 pr-3 py-2 outline-none transition-all placeholder-slate-500" />
              </div>
            </div>
          </div>

          <!-- Users Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="usersCardsGrid">
            {{#each users}}
            <div class="user-card group rounded-2xl bg-[#161b22] border border-[#30363d] overflow-hidden hover:border-slate-500/60 transition-all shadow-lg flex flex-col" data-name="{{this.firstName}} {{this.lastName}}" data-username="{{this.username}}" data-role="{{this.role}}">
              
              <!-- Namecard Banner Header -->
              <div class="h-20 sm:h-24 w-full relative bg-[#0d1117] overflow-hidden" style="background-image: linear-gradient(180deg, rgba(13, 17, 23, 0.3) 0%, rgba(22, 27, 34, 0.95) 100%), url('{{#if this.namecard}}{{this.namecard}}{{else}}/assets/images/namecards/diluc.webp{{/if}}'); background-size: cover; background-position: center;">
                <!-- Role Badge -->
                <div class="absolute top-2.5 right-2.5">
                  {{#if (eq this.role 'admin')}}
                  <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-red-600/90 text-white border border-red-400 shadow-md">Admin</span>
                  {{else if (eq this.role 'moderator')}}
                  <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-600/90 text-white border border-amber-400 shadow-md">Moderator</span>
                  {{else}}
                  <span class="px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-[#0d1117]/80 text-slate-300 border border-[#30363d] backdrop-blur-xs">Member</span>
                  {{/if}}
                </div>
              </div>

              <!-- User Body & Overlapping Avatar -->
              <div class="px-4 pb-4 pt-0 flex-1 flex flex-col -mt-8 relative z-10">
                <div class="flex items-end justify-between mb-2.5">
                  <div class="relative">
                    <img src="{{#if this.profilePic}}{{this.profilePic}}{{else}}/assets/images/profilePics/diluc_skin.webp{{/if}}" alt="{{this.username}}" class="w-14 h-14 rounded-2xl object-cover border-2 border-[#161b22] bg-[#0d1117] shadow-xl" onerror="this.src='/assets/images/profilePics/diluc_skin.webp'" />
                  </div>
                  {{#if (eq ../role 'admin')}}
                  <!-- Admin Actions -->
                  <div class="flex items-center gap-1.5 pb-1">
                    <button type="button" title="Edit Basic Info" class="btn-edit-user-modal p-1.5 rounded-lg bg-[#21262d] hover:bg-amber-600 text-amber-300 hover:text-white border border-[#30363d] transition-colors cursor-pointer" data-id="{{this._id}}" data-firstname="{{this.firstName}}" data-lastname="{{this.lastName}}" data-username="{{this.username}}" data-role="{{this.role}}">
                      <i class="ti ti-edit text-xs"></i>
                    </button>
                    <button type="button" title="Delete User" class="btn-delete-user-modal p-1.5 rounded-lg bg-[#21262d] hover:bg-rose-600 text-rose-300 hover:text-white border border-[#30363d] transition-colors cursor-pointer" data-id="{{this._id}}" data-username="{{this.username}}">
                      <i class="ti ti-trash text-xs"></i>
                    </button>
                  </div>
                  {{/if}}
                </div>

                <div class="space-y-0.5">
                  <h4 class="font-bold text-white text-sm truncate leading-snug">{{this.firstName}} {{this.lastName}}</h4>
                  <p class="text-xs text-slate-400 font-mono truncate">@{{this.username}}</p>
                </div>
              </div>

            </div>
            {{/each}}
          </div>
        </section>

        <!-- SECTION 6: Settings -->
        <section id="content-6" class="space-y-5" style="display:none;">
          <div class="matte-card-diluc p-6 rounded-2xl bg-[#161b22] border border-[#30363d] shadow-xl space-y-6">
            {{#if (eq role 'admin')}}
            <div>
              <div class="flex items-center gap-2 mb-3">
                <i class="ti ti-adjustments text-red-400 text-lg"></i>
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Global System Configuration</h4>
              </div>
              <form action="/misc/setting" method="POST" class="flex items-center justify-between p-4 rounded-xl bg-[#0d1117] border border-[#30363d]">
                <div>
                  <p class="font-semibold text-slate-200 text-xs">Public User Registration</p>
                  <p class="text-[11px] text-slate-400">Allow new users to sign up via /register route</p>
                </div>
                <div class="flex items-center space-x-2">
                  <label class="switch">
                    <input type="checkbox" name="registerRoute" id="registerRoute" value="true" {{#if (eq settings.registerRoute true)}} checked {{/if}}>
                    <span class="slider"></span>
                  </label>
                  <button type="submit" class="px-4 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors uppercase cursor-pointer">Save</button>
                </div>
              </form>
            </div>
            {{else}}
            <div class="text-center py-6 space-y-2">
              <i class="ti ti-settings text-slate-500 text-3xl"></i>
              <p class="text-sm font-semibold text-slate-300">System Configuration</p>
              <p class="text-xs text-slate-500">Administrator settings are managed by system admins.</p>
              <div class="pt-3">
                <a href="/dashboard/profile" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#21262d] hover:bg-[#30363d] text-white text-xs font-semibold border border-[#30363d] transition-colors">
                  <i class="ti ti-user-edit text-red-400"></i>
                  <span>Manage Profile & Customization</span>
                </a>
              </div>
            </div>
            {{/if}}
          </div>
        </section>

      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script defer type="text/javascript" src="/js/script.js"></script>

{{#if messages.success}}
<script>
  window.addEventListener('DOMContentLoaded', function() {
    if (typeof showAlertBox === 'function') {
      showAlertBox('{{messages.success}}');
    }
  });
</script>
{{/if}}
{{#if messages.error}}
<script>
  window.addEventListener('DOMContentLoaded', function() {
    if (typeof showAlertErrorBox === 'function') {
      showAlertErrorBox('{{messages.error}}');
    }
  });
</script>
{{/if}}
<!-- Toast Notifications -->
<div id="alertBox" class="toast-box text-white bg-emerald-700 border border-emerald-500/50">
</div>
<div id="alertBoxError" class="toast-box text-white bg-red-800 border border-red-500/50">
</div>

{{> dashboard/logoutModal}}

<div class="bg-[#0d1117] fixed inset-0 z-50 flex flex-col justify-center items-center" id="loader">
  <span class="loader mb-3"></span>
  <p class="text-slate-400 font-medium text-xs tracking-wider uppercase">Loading FlameForge...</p>
</div>


<div class="bg-[#0d1117] fixed inset-0 z-50 flex flex-col justify-center items-center" id="loader">
  <span class="loader mb-3"></span>
  <p class="text-slate-400 font-medium text-xs tracking-wider uppercase">Loading Character Record...</p>
</div>

<div class="min-h-screen bg-[#0d1117] text-slate-100 py-8 px-4 sm:px-8 font-sans">
  <div class="max-w-5xl mx-auto space-y-5">
    
    <!-- Top Navigation Bar -->
    <div class="flex items-center justify-between">
      <a href="/dashboard" class="px-3.5 py-1.5 rounded-lg bg-[#161b22] hover:bg-[#21262d] text-slate-300 border border-[#30363d] text-xs font-semibold transition-colors flex items-center gap-1.5">
        <i class="ti ti-arrow-left text-sm"></i> Return to Dashboard
      </a>
      <span class="text-xs text-slate-400 font-mono">ID: {{character._id}}</span>
    </div>

    <!-- Character Header Card -->
    <div class="matte-card-diluc p-6 rounded-2xl relative overflow-hidden flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div class="relative">
        <img src="{{character.images.profile}}" alt="{{character.name}}" class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl object-cover border-2 border-red-500/60 bg-[#0d1117]" />
        <span class="absolute -bottom-1 -right-1 px-2 py-0.2 rounded text-[9px] font-black uppercase bg-red-600 text-white">{{character.vision}}</span>
      </div>
      <div class="text-center sm:text-left flex-1">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold text-white">{{character.name}}</h1>
          <span class="px-2.5 py-0.5 rounded-lg bg-amber-500/20 text-amber-300 font-bold text-xs border border-amber-500/30">{{character.rarity}}★ {{character.weapon}}</span>
        </div>
        <p class="text-xs text-slate-300 mt-1">{{#if character.title}}{{character.title}}{{else}}{{character.name}}{{/if}} &bull; {{character.region}}</p>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed max-w-3xl">{{character.desc}}</p>
      </div>
    </div>

    <!-- Edit Form -->
    <form class="space-y-5" action="/dashboard/character/edit/{{character._id}}" method="POST">
      
      <!-- 1. Core Attributes Card -->
      <div class="matte-card p-5 rounded-2xl space-y-3.5">
        <h2 class="text-xs font-bold text-red-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-id text-base"></i> 1. Core Profile & Identity
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label for="name" class="block font-bold text-slate-300 mb-1">Character Name</label>
            <input type="text" name="name" id="name" value="{{character.name}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="birthday" class="block font-bold text-slate-300 mb-1">Birthday</label>
            <input type="text" name="birthday" id="birthday" value="{{character.birthday}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="vr" class="block font-bold text-slate-300 mb-1">Version Release</label>
            <input type="text" name="vr" id="vr" value="{{character.versionRelease}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs pt-1">
          <div>
            <label class="block font-bold text-slate-300 mb-1">Rarity</label>
            <select name="rarity" class="w-full matte-input px-3 py-2 rounded-lg text-xs">
              <option value="5" {{#if (eq character.rarity 5)}}selected{{/if}}>5 Star (★★★★★)</option>
              <option value="4" {{#if (eq character.rarity 4)}}selected{{/if}}>4 Star (★★★★)</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Vision / Element</label>
            <select name="vision" class="w-full matte-input px-3 py-2 rounded-lg text-xs">
              <option value="Pyro" {{#if (eq character.vision 'Pyro')}}selected{{/if}}>Pyro (Fire)</option>
              <option value="Hydro" {{#if (eq character.vision 'Hydro')}}selected{{/if}}>Hydro (Water)</option>
              <option value="Anemo" {{#if (eq character.vision 'Anemo')}}selected{{/if}}>Anemo (Wind)</option>
              <option value="Electro" {{#if (eq character.vision 'Electro')}}selected{{/if}}>Electro (Lightning)</option>
              <option value="Dendro" {{#if (eq character.vision 'Dendro')}}selected{{/if}}>Dendro (Nature)</option>
              <option value="Cryo" {{#if (eq character.vision 'Cryo')}}selected{{/if}}>Cryo (Ice)</option>
              <option value="Geo" {{#if (eq character.vision 'Geo')}}selected{{/if}}>Geo (Earth)</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Weapon Type</label>
            <select name="weapon" class="w-full matte-input px-3 py-2 rounded-lg text-xs">
              <option value="Sword" {{#if (eq character.weapon 'Sword')}}selected{{/if}}>Sword</option>
              <option value="Claymore" {{#if (eq character.weapon 'Claymore')}}selected{{/if}}>Claymore</option>
              <option value="Polearm" {{#if (eq character.weapon 'Polearm')}}selected{{/if}}>Polearm</option>
              <option value="Bow" {{#if (eq character.weapon 'Bow')}}selected{{/if}}>Bow</option>
              <option value="Catalyst" {{#if (eq character.weapon 'Catalyst')}}selected{{/if}}>Catalyst</option>
            </select>
          </div>
          <div>
            <label for="model" class="block font-bold text-slate-300 mb-1">Model Type</label>
            <input type="text" name="model" id="model" value="{{character.model}}" placeholder="Medium Female / Tall Male" class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-1">
          <div>
            <label for="title" class="block font-bold text-slate-300 mb-1">Title(s) (Comma Separated)</label>
            <input type="text" name="title" id="title" value="{{character.title}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="constellation" class="block font-bold text-slate-300 mb-1">Constellation Name</label>
            <input type="text" name="constellation" id="constellation" value="{{character.constellation}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-1">
          <div>
            <label for="region" class="block font-bold text-slate-300 mb-1">Region(s)</label>
            <input type="text" name="region" id="region" value="{{character.region}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="affiliation" class="block font-bold text-slate-300 mb-1">Affiliation(s)</label>
            <input type="text" name="affiliation" id="affiliation" value="{{character.affiliation}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="text-xs pt-1">
          <label for="desc" class="block font-bold text-slate-300 mb-1">Description & Lore Summary</label>
          <textarea name="desc" id="desc" rows="3" required class="w-full matte-input p-3 rounded-lg text-xs leading-relaxed resize-none">{{character.desc}}</textarea>
        </div>
      </div>

      <!-- 2. Voice Actors (CV) Card -->
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-microphone text-base"></i> 2. Voice Actors (CV)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
          <div>
            <label class="block font-bold text-slate-300 mb-1">English (EN)</label>
            <input type="text" name="cv_en" value="{{character.cv.en}}" placeholder="EN Voice Actor" class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Japanese (JP)</label>
            <input type="text" name="cv_jp" value="{{character.cv.jp}}" placeholder="JP Voice Actor" class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Chinese (CN)</label>
            <input type="text" name="cv_cn" value="{{character.cv.cn}}" placeholder="CN Voice Actor" class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Korean (KR)</label>
            <input type="text" name="cv_kr" value="{{character.cv.kr}}" placeholder="KR Voice Actor" class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>
      </div>

      <!-- 3. Image URLs Card -->
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-photo text-base"></i> 3. Media & Artwork Links
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label for="imgProfile" class="block font-bold text-slate-300 mb-1">Square Profile Icon URL</label>
            <input type="url" name="imgProfile" id="imgProfile" value="{{character.images.profile}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="imgGacha" class="block font-bold text-slate-300 mb-1">Full Gacha Splash Art URL</label>
            <input type="url" name="imgGacha" id="imgGacha" value="{{character.images.gacha}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="imgCard" class="block font-bold text-slate-300 mb-1">Card Art / Banner URL</label>
            <input type="url" name="imgCard" id="imgCard" value="{{character.images.card}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>
        <div class="text-xs pt-1">
          <label for="wikiUrl" class="block font-bold text-slate-300 mb-1">Wiki / HoYoLab URL</label>
          <input type="url" name="wikiUrl" id="wikiUrl" value="{{character.wikiUrl}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
        </div>
      </div>

      <!-- 4. Combat Talents Display -->
      {{#if character.talents}}
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-teal-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-swords text-base"></i> 4. Combat Talents ({{character.talents.length}})
        </h2>
        <div class="space-y-2.5">
          {{#each character.talents}}
          <div class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d] space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-white text-xs">{{this.name}}</span>
              <span class="px-2 py-0.2 rounded bg-teal-500/20 text-teal-300 text-[10px] font-semibold">{{this.type}}</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">{{this.desc}}</p>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- 5. Constellations Display -->
      {{#if character.constellations}}
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-sparkles text-base"></i> 5. Constellations (C1 - C6)
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {{#each character.constellations}}
          <div class="p-3 rounded-xl bg-[#0d1117] border border-amber-500/20 space-y-1">
            <span class="font-bold text-amber-300 text-xs">C{{this.level}}: {{this.name}}</span>
            <p class="text-[11px] text-slate-300 leading-relaxed">{{this.desc}}</p>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- 6. Stories Lore Display -->
      {{#if character.stories}}
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-book text-base"></i> 6. Character Lore Stories ({{character.stories.length}})
        </h2>
        <div class="space-y-2">
          {{#each character.stories}}
          <details class="p-3 rounded-xl bg-[#0d1117] border border-[#30363d] cursor-pointer">
            <summary class="font-bold text-white text-xs">{{this.title}}</summary>
            <p class="mt-2 text-xs text-slate-300 leading-relaxed whitespace-pre-line border-t border-[#30363d] pt-2">{{this.desc}}</p>
          </details>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <!-- Action Buttons -->
      <div class="flex justify-end space-x-2.5 pt-3">
        <a href="/dashboard" class="px-5 py-2.5 rounded-xl bg-[#161b22] hover:bg-[#21262d] text-slate-300 font-bold text-xs transition-colors border border-[#30363d]">Cancel</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs transition-colors shadow-md shadow-red-600/30 flex items-center gap-1.5 cursor-pointer">
          <i class="ti ti-device-floppy text-base"></i> Save Character
        </button>
      </div>

    </form>

  </div>
</div>

<script>
  window.addEventListener('load', () => {
    const loader = document.getElementById('loader');
    if (loader) loader.style.display = 'none';
  });
</script>
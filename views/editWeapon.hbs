<div class="bg-[#0d1117] fixed inset-0 z-50 flex flex-col justify-center items-center" id="loader">
  <span class="loader mb-3"></span>
  <p class="text-slate-400 font-medium text-xs tracking-wider uppercase">Loading Weapon Record...</p>
</div>

<div class="min-h-screen bg-[#0d1117] text-slate-100 py-8 px-4 sm:px-8 font-sans">
  <div class="max-w-5xl mx-auto space-y-5">
    
    <!-- Top Navigation Bar -->
    <div class="flex items-center justify-between">
      <a href="/dashboard" class="px-3.5 py-1.5 rounded-lg bg-[#161b22] hover:bg-[#21262d] text-slate-300 border border-[#30363d] text-xs font-semibold transition-colors flex items-center gap-1.5">
        <i class="ti ti-arrow-left text-sm"></i> Return to Dashboard
      </a>
      <span class="text-xs text-slate-400 font-mono">ID: {{weapon._id}}</span>
    </div>

    <!-- Weapon Header Card -->
    <div class="matte-card-diluc p-6 rounded-2xl relative overflow-hidden flex flex-col sm:flex-row items-center sm:items-start gap-5">
      <div class="relative">
        <img src="{{weapon.images.icon}}" alt="{{weapon.name}}" class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl object-cover border-2 border-amber-500/60 bg-[#0d1117]" />
      </div>
      <div class="text-center sm:text-left flex-1">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
          <h1 class="text-2xl sm:text-3xl font-bold text-white">{{weapon.name}}</h1>
          <span class="px-2.5 py-0.5 rounded-lg bg-amber-500/20 text-amber-300 font-bold text-xs border border-amber-500/30">{{weapon.rarity}}★ {{weapon.family}}</span>
        </div>
        <p class="text-xs text-amber-300/80 mt-1">Base ATK: {{weapon.baseAtk}} &bull; {{weapon.subStatType}}: {{weapon.baseSubStat}} &bull; {{weapon.region}}</p>
        <p class="text-xs text-slate-400 mt-2 leading-relaxed max-w-3xl">{{weapon.desc}}</p>
      </div>
    </div>

    <!-- Edit Form -->
    <form class="space-y-5" action="/dashboard/weapon/edit/{{weapon._id}}" method="POST">
      
      <!-- 1. Core Profile & Combat Stats -->
      <div class="matte-card p-5 rounded-2xl space-y-3.5">
        <h2 class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-swords text-base"></i> 1. Core Profile & Combat Stats
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label for="name" class="block font-bold text-slate-300 mb-1">Weapon Name</label>
            <input type="text" name="name" id="name" value="{{weapon.name}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Weapon Family</label>
            <select name="family" class="w-full matte-input px-3 py-2 rounded-lg text-xs">
              <option value="Sword" {{#if (eq weapon.family 'Sword')}}selected{{/if}}>Sword</option>
              <option value="Claymore" {{#if (eq weapon.family 'Claymore')}}selected{{/if}}>Claymore</option>
              <option value="Polearm" {{#if (eq weapon.family 'Polearm')}}selected{{/if}}>Polearm</option>
              <option value="Bow" {{#if (eq weapon.family 'Bow')}}selected{{/if}}>Bow</option>
              <option value="Catalyst" {{#if (eq weapon.family 'Catalyst')}}selected{{/if}}>Catalyst</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-300 mb-1">Rarity</label>
            <select name="rarity" class="w-full matte-input px-3 py-2 rounded-lg text-xs">
              <option value="5" {{#if (eq weapon.rarity 5)}}selected{{/if}}>5 Star (★★★★★)</option>
              <option value="4" {{#if (eq weapon.rarity 4)}}selected{{/if}}>4 Star (★★★★)</option>
              <option value="3" {{#if (eq weapon.rarity 3)}}selected{{/if}}>3 Star (★★★)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
          <div>
            <label for="baseAtk" class="block font-bold text-slate-300 mb-1">Base ATK (Lv1)</label>
            <input type="text" name="baseAtk" id="baseAtk" value="{{weapon.baseAtk}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="subStatType" class="block font-bold text-slate-300 mb-1">Substat Type</label>
            <input type="text" name="subStatType" id="subStatType" value="{{weapon.subStatType}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="baseSubStat" class="block font-bold text-slate-300 mb-1">Base Substat Value</label>
            <input type="text" name="baseSubStat" id="baseSubStat" value="{{weapon.baseSubStat}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
          <div>
            <label for="vr" class="block font-bold text-slate-300 mb-1">Version Released</label>
            <input type="text" name="vr" id="vr" value="{{weapon.versionRelease}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="region" class="block font-bold text-slate-300 mb-1">Region</label>
            <input type="text" name="region" id="region" value="{{weapon.region}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="source" class="block font-bold text-slate-300 mb-1">Source / Method to Obtain</label>
            <input type="text" name="source" id="source" value="{{weapon.source}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-1">
          <div>
            <label for="affix" class="block font-bold text-slate-300 mb-1">Passive Name (Affix)</label>
            <input type="text" name="affix" id="affix" value="{{weapon.affix}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="wikiUrl" class="block font-bold text-slate-300 mb-1">HoYoWiki / Wiki URL</label>
            <input type="url" name="wikiUrl" id="wikiUrl" value="{{weapon.wikiUrl}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>

        <div class="text-xs pt-1">
          <label for="passive" class="block font-bold text-slate-300 mb-1">Passive Effect Description</label>
          <textarea name="passive" id="passive" rows="3" required class="w-full matte-input p-3 rounded-lg text-xs leading-relaxed resize-none">{{weapon.passive}}</textarea>
        </div>

        <div class="text-xs pt-1">
          <label for="desc" class="block font-bold text-slate-300 mb-1">Weapon Lore & Background</label>
          <textarea name="desc" id="desc" rows="3" required class="w-full matte-input p-3 rounded-lg text-xs leading-relaxed resize-none">{{weapon.desc}}</textarea>
        </div>
      </div>

      <!-- 2. Weapon Media Links -->
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-indigo-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-photo text-base"></i> 2. Weapon Media & Artwork
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
          <div>
            <label for="icon" class="block font-bold text-slate-300 mb-1">Square Icon URL</label>
            <input type="url" name="icon" id="icon" value="{{weapon.images.icon}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="original" class="block font-bold text-slate-300 mb-1">Original Model Image URL</label>
            <input type="url" name="original" id="original" value="{{weapon.images.original}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="awakened" class="block font-bold text-slate-300 mb-1">Awakened Model Image URL</label>
            <input type="url" name="awakened" id="awakened" value="{{weapon.images.awakened}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
          <div>
            <label for="gacha" class="block font-bold text-slate-300 mb-1">Gacha Art URL</label>
            <input type="url" name="gacha" id="gacha" value="{{weapon.images.gacha}}" required class="w-full matte-input px-3 py-2 rounded-lg text-xs" />
          </div>
        </div>
      </div>

      <!-- 3. Weapon Stats Scaling Table -->
      {{#if weapon.statsTable}}
      <div class="matte-card p-5 rounded-2xl space-y-3">
        <h2 class="text-xs font-bold text-teal-400 uppercase tracking-wider flex items-center gap-1.5">
          <i class="ti ti-table text-base"></i> 3. Progression Stats Table (Lv1 - Lv90)
        </h2>
        <div class="overflow-x-auto max-h-60 rounded-xl border border-[#30363d] bg-[#0d1117]">
          <table class="w-full text-left text-xs font-sans">
            <thead class="bg-[#161b22] text-slate-300 uppercase tracking-wider border-b border-[#30363d]">
              <tr>
                <th class="p-2.5">Level</th>
                <th class="p-2.5">Base ATK</th>
                <th class="p-2.5">Substat Value</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#30363d] text-slate-300">
              {{#each weapon.statsTable}}
              <tr class="hover:bg-[#161b22]/60 transition-colors">
                <td class="p-2.5 font-bold text-amber-300">{{this.level}}</td>
                <td class="p-2.5">{{this.baseAtk}}</td>
                <td class="p-2.5">{{this.subStat}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
      {{/if}}

      <!-- Action Buttons -->
      <div class="flex justify-end space-x-2.5 pt-3">
        <a href="/dashboard" class="px-5 py-2.5 rounded-xl bg-[#161b22] hover:bg-[#21262d] text-slate-300 font-bold text-xs transition-colors border border-[#30363d]">Cancel</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition-colors shadow-md shadow-amber-600/30 flex items-center gap-1.5 cursor-pointer">
          <i class="ti ti-device-floppy text-base"></i> Save Weapon
        </button>
      </div>

    </form>

  </div>
</div>

<script>
  window.addEventListener('load', () => {
    const loader = document.getElementById('loader');
    if (loader) loader.style.display = 'none';
  });
</script>
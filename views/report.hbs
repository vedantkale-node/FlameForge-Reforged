<div class="min-h-[100dvh] min-h-screen flex items-center justify-center p-4 sm:p-6 bg-[#0d1117] text-slate-100 relative overflow-x-hidden font-sans">
  
  <!-- Toast Notification Container -->
  <div id="alertBox" class="toast-box text-white bg-emerald-800 border border-emerald-500/50">
  </div>
  <div id="alertBoxError" class="toast-box text-white bg-red-800 border border-red-500/50">
  </div>

  <!-- Matte Report Card -->
  <div class="relative w-full max-w-lg z-10 my-auto">
    <div class="matte-card-diluc p-6 sm:p-8 md:p-10 shadow-2xl relative overflow-hidden border border-red-500/30 rounded-2xl">
      
      <!-- Top Subtle Flame Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-1 sm:h-1.5 bg-gradient-to-r from-red-600 via-amber-500 to-red-600"></div>

      <!-- Header Section -->
      <div class="flex flex-col items-center text-center mb-6 sm:mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-500/15 border border-red-500/30 text-red-400 text-[11px] font-bold tracking-wider uppercase mb-2.5">
          <i class="ti ti-bug text-xs"></i>
          <span>Support & Bug Dispatch</span>
        </div>
        
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Submit Issue Report</h1>
        <p class="text-xs text-slate-400 mt-1 max-w-sm leading-relaxed">Found an unexpected payload or API discrepancy? Dispatch a report directly to the core developers.</p>
      </div>

      <!-- Flash Message Banners -->
      {{#if messages.error}}
      <div class="mb-5 flex items-start gap-2.5 p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs leading-relaxed">
        <i class="ti ti-alert-triangle text-red-400 text-base shrink-0 mt-0.5"></i>
        <span>{{messages.error}}</span>
      </div>
      {{/if}}

      {{#if messages.success}}
      <div class="mb-5 flex items-start gap-2.5 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs leading-relaxed">
        <i class="ti ti-circle-check text-emerald-400 text-base shrink-0 mt-0.5"></i>
        <span>{{messages.success}}</span>
      </div>
      {{/if}}

      <!-- Report Form -->
      <form action="/misc/report" method="POST" id="reportForm" class="space-y-4" novalidate>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Your Name</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="ti ti-user text-base"></i>
              </div>
              <input
                type="text"
                name="name"
                id="name"
                class="w-full pl-11 pr-4 py-2.5 sm:py-3 rounded-xl text-xs text-white placeholder-slate-500 outline-none matte-input"
                placeholder="Diluc Ragnvindr"
                required
              />
            </div>
          </div>

          <!-- Email Field -->
          <div>
            <label for="email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Email Address</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <i class="ti ti-mail text-base"></i>
              </div>
              <input
                type="email"
                name="email"
                id="email"
                class="w-full pl-11 pr-4 py-2.5 sm:py-3 rounded-xl text-xs text-white placeholder-slate-500 outline-none matte-input"
                placeholder="diluc@dawnwinery.com"
                required
              />
            </div>
          </div>
        </div>

        <!-- Target Endpoint / URL Field -->
        <div>
          <label for="errorUrl" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Target Endpoint / URL</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="ti ti-link text-base"></i>
            </div>
            <input
              type="url"
              name="errorUrl"
              id="errorUrl"
              class="w-full pl-11 pr-4 py-2.5 sm:py-3 rounded-xl text-xs text-white placeholder-slate-500 outline-none matte-input font-mono"
              placeholder="https://api.flameforge.dev/api/characters/Diluc"
              required
            />
          </div>
        </div>

        <!-- Issue Description Field -->
        <div>
          <label for="message" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Issue Description</label>
          <textarea
            name="message"
            id="message"
            rows="4"
            class="w-full p-3.5 rounded-xl text-xs text-white placeholder-slate-500 outline-none matte-input resize-none leading-relaxed"
            placeholder="Describe the unexpected error code, schema mismatch, or reproduction steps..."
            required
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="btnSubmitReport"
          class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-bold text-xs tracking-wider uppercase transition-all shadow-lg shadow-red-600/30 flex items-center justify-center gap-2 mt-5 cursor-pointer"
        >
          <i class="ti ti-send text-base"></i>
          <span>Send Report</span>
        </button>
      </form>

      <!-- Back Navigation -->
      <div class="mt-5 pt-4 border-t border-[#30363d] flex items-center justify-between text-xs text-slate-400">
        <a href="/sign-in" class="hover:text-white transition-colors flex items-center gap-1">
          <i class="ti ti-arrow-left text-xs"></i>
          <span>Return to Sign In</span>
        </a>
        <a href="/dashboard" class="hover:text-red-400 transition-colors flex items-center gap-1">
          <span>Go to Dashboard</span>
          <i class="ti ti-chevron-right text-xs"></i>
        </a>
      </div>

    </div>
  </div>
</div>

<script src="/js/report.js"></script>